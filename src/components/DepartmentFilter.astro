---
interface Props {
    /** Department names to offer as options. */
    departments: string[];
}

const { departments } = Astro.props;
---

<div class="flex flex-col gap-2 sm:flex-row sm:items-center mb-6">
    <label for="department-filter" class="text-sm font-medium text-slate-300">
        Department
    </label>
    <select
        id="department-filter"
        data-testid="department-filter"
        class="w-full sm:w-72 rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2E6CFC]"
    >
        <option value="">All departments</option>
        {departments.map((department) => <option value={department}>{department}</option>)}
    </select>
</div>
